# Copy to .env and fill in. .env is git-ignored; this template is safe to commit.
MP_TOKEN_ID=
MP_TOKEN_SECRET=
MP_SDK_KEY=
VEXCEL_API_KEY=
COSTAR_KIT_ZIP_PASSWORD=
# Proppy agent (app/agent). Optional: the app runs without them, Proppy just can't answer.
ANTHROPIC_API_KEY=
PROPPY_MODEL=
# Edit API (tools/edit_api/README.md). On Mateo's PC: the key the API accepts (any long random
# string, `server.py --make-token` writes one), the campus Wi-Fi address to bind besides 127.0.0.1
# (never 0.0.0.0), and the client addresses allowed (IPs, CIDR ranges, or * for any).
EDIT_API_TOKEN=
EDIT_API_HOST=127.0.0.1
EDIT_API_ALLOW=
# Optional: browser origins allowed to call the edit API directly (empty when the web app's server calls it).
EDIT_API_CORS=
# On the web app laptop: http://<the PC's address>:2026. Mateo gives the address and the key
# (EDIT_API_TOKEN above, the same key) privately.
EDIT_API_URL=
